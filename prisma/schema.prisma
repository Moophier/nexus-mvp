datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum Role {
  SEEKER
  PROVIDER
  BOTH
}

enum ModuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
}

model User {
  id            String        @id @default(cuid())
  phone         String?       @unique
  email         String?       @unique
  name          String?
  role          Role          @default(SEEKER)
  createdAt     DateTime      @default(now())
  accounts      Account[]
  sessions      Session[]
  modules       Module[]
  purchases     Purchase[]
  reviews       Review[]
  assetAccount  AssetAccount?
  transactions  Transaction[]
}

model Module {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  summary     String        @db.Text
  content     String        @db.Text
  priceCents  Int
  status      ModuleStatus  @default(DRAFT)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  createdAt   DateTime      @default(now())
  purchases   Purchase[]
  reviews     Review[]
  fragments   Fragment[]

  @@index([status, createdAt])
}

model Purchase {
  id          String         @id @default(cuid())
  userId      String
  moduleId    String
  priceCents  Int
  status      PurchaseStatus @default(PENDING)
  paymentRef  String?
  paidAt      DateTime?
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id])
  module      Module         @relation(fields: [moduleId], references: [id])
  review      Review?

  @@unique([userId, moduleId])
  @@index([status])
}

model Review {
  id          String     @id @default(cuid())
  purchaseId  String     @unique
  userId      String
  moduleId    String
  rating      Int
  body        String     @db.Text
  createdAt   DateTime   @default(now())
  purchase    Purchase   @relation(fields: [purchaseId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
  module      Module     @relation(fields: [moduleId], references: [id])
  fragments   Fragment[]

  @@index([moduleId, createdAt])
}

model Fragment {
  id        String   @id @default(cuid())
  reviewId  String
  moduleId  String
  quote     String   @db.Text
  link      String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id])
  module    Module   @relation(fields: [moduleId], references: [id])

  @@index([moduleId, createdAt])
}

model AssetAccount {
  userId       String   @id
  balanceCents Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  amountCents Int
  reason      String
  refType     String?
  refId       String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
